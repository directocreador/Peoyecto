  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#050604">
  <title>SuiteSite — Logo</title>
  <style>
    :root {
      --night: #050604;
      --white: #fffef9;
      --mint: #a8ffd1;
    }

    * { box-sizing: border-box; }

    html, body { margin: 0; width: 100%; }

    body {
      min-height: calc(100 * min(var(--vh, 1vh), 1vh));
      color: var(--white);
      background: var(--night);
      font-family: "Work Sans", sans-serif;
    }

    .logo-page {
      position: relative;
      display: grid;
      width: 100%;
      min-height: calc(100 * min(var(--vh, 1vh), 1vh));
      place-items: center;
      overflow: hidden;
      isolation: isolate;
      padding: 56px 24px;
    }

    .logo-page::before {
      content: "";
      position: absolute;
      z-index: -1;
      inset: 0;
      pointer-events: none;
      opacity: .55;
      background-image:
        radial-gradient(circle at 14% 23%, #ffffff80 0 1px, transparent 1.5px),
        radial-gradient(circle at 82% 16%, #ffffff65 0 1px, transparent 1.5px),
        radial-gradient(circle at 72% 76%, #ffffff70 0 1px, transparent 1.5px),
        radial-gradient(circle at 23% 81%, #ffffff55 0 1px, transparent 1.5px),
        radial-gradient(circle at 91% 55%, #a8ffd160 0 1px, transparent 1.5px);
      background-size: 100% 100%;
    }

    .brand {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: min(100%, 430px);
      transform: translateY(-1%);
    }

    .mark {
      position: relative;
      width: min(68vw, 310px);
      aspect-ratio: 1;
    }

    .mark-svg {
      display: block;
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    .top-line {
      width: min(27vw, 116px);
      height: 5px;
      margin-bottom: 30px;
      border-radius: 100px;
      background: var(--mint);
      box-shadow: 0 0 12px #a8ffd1a0, 0 0 32px #a8ffd155;
    }

    .orbit {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      animation: revolve 7s linear infinite;
      pointer-events: none;
    }

    .orb {
      position: absolute;
      top: 3.9%;
      left: 50%;
      width: 15px;
      height: 15px;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      background: #effff5;
      box-shadow:
        0 0 7px 3px #ffffff,
        0 0 18px 7px #a8ffd1b8,
        0 0 42px 13px #a8ffd16e;
    }

    .brand-name {
      margin: 33px 0 0;
      color: var(--white);
      font-size: 15px;
      font-weight: 500;
      letter-spacing: .25em;
      line-height: 1.5;
      text-align: center;
    }

    @keyframes revolve { to { transform: rotate(360deg); } }

    @media (max-width: 480px) {
      .top-line { height: 4px; margin-bottom: 25px; }
      .brand-name { margin-top: 28px; }
      .orb { width: 12px; height: 12px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .orbit { animation: none; }
    }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.577.0/dist/umd/lucide.min.js" type="text/javascript"></script>
  <script src="https://cdn.tailwindcss.com/3.4.17" type="text/javascript"></script>
  <script src="/_sdk/47b49acbce8d4e14.data_sdk.js" type="text/javascript" integrity="sha512-Q7ocGwX+GJGp9twzwnkXfCUAwQkaCh99VK0LYmxqjQvV3IEFlYrnsSbtoFLMg9907WJYePujU3Tm4/KkNQa1wA=="></script>
  <script src="/_sdk/e377dd2e89eaf46e.editing_sdk.js" type="text/javascript" integrity="sha512-Yb01Sogdc7iekk4RUo8wowcDWWOaYm0zS43022MSWUHEQ3s9VnInFoewxq5KGoOcEWTDKOEIc5sFTJgdnZQMhw=="></script>
  <script src="/_sdk/c774963abc6f03de.resizing_sdk.js" type="text/javascript" integrity="sha512-fVA81vJnL46vGKioyJJbk3XaJjdaKaDnDMTShVQ1S1kBQM4xcUhuy93NTuRYEspgyUVmkpVo4DcQ4X0vP2kYcQ=="></script>
 </head>
 <body data-template-id="__page-root" class="w-full" style="background: rgb(5, 6, 4);">
  <main class="logo-page" aria-label="Logo de SuiteSite">
   <div class="brand">
    <div class="top-line" aria-hidden="true"></div>
    <div class="mark" role="img" aria-label="Letra S blanca dentro de un círculo continuo, con un punto luminoso verde menta en órbita">
     <svg class="mark-svg" viewBox="0 0 310 310" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="155" cy="155" r="143" fill="none" stroke="#fffef9" stroke-width="11"></circle> <path d="M 202 92 C 188 73, 169 65, 145 68 C 111 71, 90 92, 90 119 C 90 145, 111 156, 153 163 C 194 170, 218 181, 218 209 C 218 239, 190 256, 154 256 C 123 256, 99 243, 83 220" fill="none" stroke="#fffef9" stroke-width="21" stroke-linecap="round" stroke-linejoin="round"></path>
     </svg>
     <div class="orbit" aria-hidden="true">
      <span class="orb"></span>
     </div>
    </div>
    <p data-template-id="brand-name" class="canva-text brand-name" style="color: rgb(255, 254, 249); font-weight: 500; font-style: normal; font-size: 15px; letter-spacing: 0.25rem;">SuiteSite</p>
   </div>
  </main>
 
</body></html>
